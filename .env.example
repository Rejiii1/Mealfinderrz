# ─── MealFinderrz environment ────────────────────────────────────────
# Copy to `.env` and adjust. The server has sane defaults — but
# SESSION_SECRET should be set in production so sessions survive a
# wiped data directory or a container rebuild.

# HTTP port the server listens on inside the container.
# In Docker, leave at 3000 and map the host port in compose.
PORT=3000

# Cookie-session signing secret. If unset, the server generates one
# and persists it to `data/.session-key` (mode 0600). Set it here to
# rotate or to keep sessions stable across data-volume wipes.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Set to "production" to enable HSTS and Secure cookies. The Dockerfile
# already sets this; only override for local dev.
# NODE_ENV=development
